# Node / Vite
node_modules/
dist/
dev-dist/
coverage/
*.local

# Env — credentials never enter git (#4's stated prerequisite). Runtime config
# for Supabase is set in Vercel's dashboard as VITE_-prefixed variables.
.env
.env.*
!.env.example

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Legacy toolchain leftovers. The legacy tree is gone from this branch and lives
# at tag `legacy-final`; checking that tag out would recreate these.
.gradle/
build/
bin/
*.mv.db

# Production bundles pulled down for inspection — a saved copy of a deployed
# `dist/assets/index-*.js`, kept at the root while somebody reads it. Globbed and
# root-anchored rather than an exact name: the second copy somebody makes is
# `prodbundle.old.js`, and an exact-name rule is what let a credential backup
# stay committable in another repo here.
#
# NOTE: this line does NOT stop `npm run lint` reading the file. ESLint flat
# config ignores what `eslint.config.js` lists and never consults `.gitignore`,
# so that file carries the same pattern. Two lists, deliberately, because
# neither tool reads the other.
/prodbundle*.js
